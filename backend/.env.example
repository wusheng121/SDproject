APP_ENV=development
SECRET_KEY=replace-with-a-random-secret-at-least-32-bytes

# MySQL 8.0+
DATABASE_URL=mysql+pymysql://campus:campus@127.0.0.1:3307/campus_market?charset=utf8mb4
REDIS_URL=redis://127.0.0.1:6379/0
RATELIMIT_STORAGE_URI=redis://127.0.0.1:6379/1

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
BCRYPT_COST=12

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PHONE_ENC_KEY=
PHONE_HASH_KEY=
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=Lax

SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
MAIL_FROM=no-reply@campus-market.local

# 留空则购物助手用规则回答。密钥从 https://platform.deepseek.com 创建，不要提交到仓库。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

LOG_LEVEL=INFO
# SENTRY_DSN=
