.profile-page {
  padding-top: 24rpx;
}

.profile-panel {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  border: 1rpx solid var(--border);
  border-radius: 8rpx;
  background: var(--card);
}

.avatar {
  display: flex;
  width: 92rpx;
  height: 92rpx;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #ffffff;
  background: var(--primary);
  font-size: 36rpx;
  font-weight: 700;
}

.identity {
  min-width: 0;
  flex: 1;
}

.profile-name {
  display: block;
  color: var(--text);
  font-size: 32rpx;
  font-weight: 700;
}

.profile-meta {
  display: block;
  overflow: hidden;
  margin-top: 6rpx;
  color: var(--muted);
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.login-btn {
  min-height: 62rpx;
}

.menu-section {
  margin-top: 30rpx;
}

.menu-label {
  display: block;
  margin: 0 4rpx 12rpx;
  color: var(--muted);
  font-size: 22rpx;
  font-weight: 650;
}

.menu-card {
  overflow: hidden;
  border: 1rpx solid var(--border);
  border-radius: 8rpx;
  background: var(--card);
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 104rpx;
  padding: 18rpx 22rpx;
  border-bottom: 1rpx solid var(--border);
}

.menu-item:last-child {
  border-bottom: 0;
}

.menu-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 6rpx;
}

.menu-title {
  color: var(--text);
  font-size: 26rpx;
  font-weight: 650;
}

.menu-note {
  color: var(--muted);
  font-size: 21rpx;
}

.arrow {
  color: var(--light);
  font-size: 38rpx;
  line-height: 1;
}

.danger-text {
  color: var(--danger);
}

.login-gate {
  margin-top: 30rpx;
}

.stats-grid {
  display: flex;
  margin-top: 16rpx;
  border: 1rpx solid var(--border);
  border-radius: 8rpx;
  background: var(--card);
}

.stat-item {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  align-items: center;
  gap: 5rpx;
  padding: 18rpx 4rpx;
  border-right: 1rpx solid var(--border);
}

.stat-item:last-child {
  border-right: 0;
}

.stat-value {
  color: var(--primary);
  font-size: 32rpx;
  font-weight: 800;
}

.stat-label {
  color: var(--muted);
  font-size: 20rpx;
}

.preference-panel {
  padding: 22rpx;
  margin-top: 16rpx;
  border: 1rpx solid var(--border);
  border-radius: 8rpx;
  background: var(--card);
}

.preference-tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 14rpx;
}

.preference-empty {
  display: block;
  margin-top: 12rpx;
}
