<view class="page orders-page theme-{{theme}}">
  <view class="page-heading">
    <text class="eyebrow">YOUR ORDERS</text>
    <text class="page-title">我的订单</text>
    <text class="page-subtitle">查看交易状态，完成模拟支付或取消待支付订单。</text>
  </view>

  <view wx:if="{{loading}}" class="empty">正在加载...</view>
  <view wx:elif="{{orders.length === 0}}" class="empty">暂无订单</view>
  <view wx:else>
    <view wx:for="{{orders}}" wx:key="id" class="order-card">
      <view class="order-head">
        <text class="order-id">订单 #{{item.id}}</text>
        <text class="order-status status-{{item.status}}">{{item.status_text}}</text>
      </view>
      <text class="order-time">{{item.created_at}}</text>
      <view class="order-lines">
        <view wx:for="{{item.items}}" wx:for-item="line" wx:key="id" class="order-line">
          <text class="line-name one-line">{{line.name}}</text>
          <text class="muted">×{{line.quantity}}</text>
          <text class="line-price">¥{{line.price}}</text>
          <text wx:if="{{line.reviewed}}" class="reviewed">已评价</text>
          <button
            wx:elif="{{item.status === 'paid'}}"
            class="review-btn"
            data-order-id="{{item.id}}"
            data-product-id="{{line.product_id}}"
            data-name="{{line.name}}"
            bindtap="openReview"
          >评价</button>
        </view>
      </view>
      <view class="order-foot">
        <view class="order-total">
          <text class="muted">合计</text>
          <text class="price">¥{{item.total_amount}}</text>
        </view>
        <view wx:if="{{item.status === 'pending'}}" class="order-actions">
          <button class="btn btn-plain btn-sm" data-id="{{item.id}}" bindtap="cancel">取消</button>
          <button class="btn btn-sm" data-id="{{item.id}}" bindtap="pay">模拟支付</button>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{reviewVisible}}" class="modal-mask" bindtap="closeReview">
    <view class="review-modal" catchtap="stop">
      <text class="eyebrow">REVIEW</text>
      <text class="review-title">评价商品</text>
      <text class="review-product one-line">{{reviewTarget.name}}</text>
      <view class="stars">
        <text class="star {{reviewScore >= 1 ? 'active' : ''}}" data-score="1" bindtap="chooseScore">★</text>
        <text class="star {{reviewScore >= 2 ? 'active' : ''}}" data-score="2" bindtap="chooseScore">★</text>
        <text class="star {{reviewScore >= 3 ? 'active' : ''}}" data-score="3" bindtap="chooseScore">★</text>
        <text class="star {{reviewScore >= 4 ? 'active' : ''}}" data-score="4" bindtap="chooseScore">★</text>
        <text class="star {{reviewScore >= 5 ? 'active' : ''}}" data-score="5" bindtap="chooseScore">★</text>
      </view>
      <textarea class="textarea review-input" maxlength="500" value="{{reviewComment}}" bindinput="onReviewInput" placeholder="说说这次交易体验（选填）"></textarea>
      <view class="modal-actions">
        <button class="btn btn-plain" bindtap="closeReview">取消</button>
        <button class="btn" loading="{{reviewLoading}}" bindtap="submitReview">提交评价</button>
      </view>
    </view>
  </view>
</view>
