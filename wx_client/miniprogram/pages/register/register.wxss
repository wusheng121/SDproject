.auth-page {
  padding-top: 24rpx;
}

.auth-hero {
  padding: 38rpx 32rpx;
  border-radius: 8rpx;
  color: #ffffff;
  background: var(--hero);
}

.auth-eyebrow {
  display: block;
  margin-bottom: 22rpx;
  color: #b8d8c8;
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.brand-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.brand-mark {
  display: flex;
  width: 72rpx;
  height: 72rpx;
  align-items: center;
  justify-content: center;
  border-radius: 10rpx;
  color: #ffffff;
  background: #47785f;
  font-size: 34rpx;
  font-weight: 800;
}

.brand-title {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
}

.brand-subtitle {
  display: block;
  margin-top: 4rpx;
  color: rgba(255, 255, 255, 0.65);
  font-size: 21rpx;
}

.auth-title {
  display: block;
  margin-top: 36rpx;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.3;
}

.auth-note {
  display: block;
  margin-top: 16rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
  line-height: 1.7;
}

.auth-card {
  margin-top: 18rpx;
  padding: 30rpx 24rpx;
  border: 1rpx solid var(--border);
  border-radius: 8rpx;
  background: var(--card);
}

.captcha-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.captcha-input {
  flex: 1;
}

.captcha {
  width: 190rpx;
  height: 82rpx;
  border: 1rpx solid var(--border);
  border-radius: 8rpx;
  background: var(--image-bg);
}

.submit {
  margin-top: 10rpx;
}

.auth-footer {
  margin-top: 24rpx;
  text-align: center;
}

.link {
  margin-left: 10rpx;
  color: var(--primary);
  font-weight: 650;
}
