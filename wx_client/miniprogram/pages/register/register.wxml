<view class="page auth-page theme-{{theme}}">
  <view class="auth-hero">
    <text class="auth-eyebrow">JOIN THE CAMPUS</text>
    <view class="brand-row">
      <view class="brand-mark">校</view>
      <view>
        <text class="brand-title">校园集市</text>
        <text class="brand-subtitle">让闲置找到下一个主人</text>
      </view>
    </view>
    <text class="auth-title">创建账号，开始一次简单的校园交易。</text>
    <text class="auth-note">注册后可以发布闲置、收藏商品、联系卖家和创建订单。</text>
  </view>

  <view class="auth-card">
    <view class="field"><text class="label">用户名</text><input class="input" value="{{username}}" data-field="username" bindinput="onInput" placeholder="3-50 位字符" /></view>
    <view class="field"><text class="label">邮箱</text><input class="input" value="{{email}}" data-field="email" bindinput="onInput" placeholder="用于登录和账号验证" /></view>
    <view class="field"><text class="label">密码</text><input class="input" password value="{{password}}" data-field="password" bindinput="onInput" placeholder="至少 8 位，包含字母和数字" /></view>
    <view class="field"><text class="label">手机号（选填）</text><input class="input" value="{{phone}}" data-field="phone" bindinput="onInput" placeholder="方便联系" /></view>
    <view class="field">
      <text class="label">验证码</text>
      <view class="captcha-row">
        <input class="input captcha-input" maxlength="4" value="{{captchaCode}}" data-field="captchaCode" bindinput="onInput" placeholder="输入验证码" />
        <image wx:if="{{captchaImage}}" class="captcha" src="{{captchaImage}}" bindtap="loadCaptcha" mode="aspectFit"></image>
      </view>
    </view>
    <button class="btn full submit" loading="{{loading}}" bindtap="submit">注册账号</button>
    <view class="auth-footer">
      <text class="muted">已有账号？</text>
      <text class="link" bindtap="goLogin">返回登录</text>
    </view>
  </view>
</view>
