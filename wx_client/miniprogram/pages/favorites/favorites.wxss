.favorites-page {
  padding-top: 24rpx;
}

.favorite-item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.remove {
  width: 100%;
  height: 54rpx;
  color: var(--danger);
  border: 0;
  border-radius: 4rpx;
  background: transparent;
  font-size: 21rpx;
}

.remove::after {
  border: 0;
}
