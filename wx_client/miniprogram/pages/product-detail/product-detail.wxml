<view wx:if="{{loading}}" class="page theme-{{theme}}"><view class="empty">正在加载...</view></view>
<view wx:elif="{{!product}}" class="page theme-{{theme}}"><view class="empty">商品不存在</view></view>
<view wx:else class="page detail-page theme-{{theme}}">
  <view class="image-section">
    <image wx:if="{{product.image_url}}" class="hero" src="{{product.image_url}}" mode="aspectFill"></image>
    <view wx:else class="hero placeholder">商品图片</view>
    <text wx:if="{{product.condition}}" class="image-badge">{{product.condition}}</text>
  </view>

  <view class="card info-card">
    <text class="eyebrow">PRODUCT DETAIL</text>
    <view class="row between title-row">
      <text class="product-title">{{product.name}}</text>
      <text class="product-price">¥{{product.price}}</text>
    </view>
    <view class="tags">
      <text class="tag">{{product.condition}}</text>
      <text wx:for="{{product.categories}}" wx:key="*this" class="tag">{{item}}</text>
    </view>
    <view wx:if="{{product.brand}}" class="meta-row"><text class="meta-label">品牌</text><text>{{product.brand}}</text></view>
    <view wx:if="{{product.trade_method}}" class="meta-row"><text class="meta-label">交易方式</text><text>{{product.trade_method}}</text></view>
    <view wx:if="{{product.trade_location}}" class="meta-row"><text class="meta-label">交易地点</text><text>{{product.trade_location}}</text></view>
    <view class="meta-row"><text class="meta-label">卖家</text><text>{{product.seller ? product.seller.username : '-'}}</text></view>
  </view>

  <view class="card">
    <text class="eyebrow">DESCRIPTION</text>
    <text class="block-title">商品描述</text>
    <text class="description">{{product.description || '暂无描述'}}</text>
    <view wx:if="{{product.defect_description}}" class="defect">
      <text class="block-title">瑕疵说明</text>
      <text class="description">{{product.defect_description}}</text>
    </view>
  </view>

  <view class="card">
    <view class="row between">
      <view>
        <text class="eyebrow">REVIEWS</text>
        <text class="block-title">商品评价</text>
      </view>
      <text class="muted">{{reviews.length}} 条</text>
    </view>
    <view wx:if="{{reviews.length === 0}}" class="muted review-empty">暂无评价</view>
    <view wx:for="{{reviews}}" wx:key="id" class="review">
      <view class="row between">
        <text class="review-user">{{item.username || '匿名用户'}}</text>
        <text class="review-score">{{item.score}} 分</text>
      </view>
      <text class="review-comment">{{item.comment || '未填写评价'}}</text>
    </view>
  </view>

  <view class="action-bar">
    <button class="btn btn-plain action-secondary" bindtap="favorite">{{favorite ? '取消收藏' : '收藏'}}</button>
    <button class="btn btn-plain action-secondary" bindtap="contactSeller">联系卖家</button>
    <button class="btn action-primary" bindtap="addToCart">加入购物车</button>
  </view>
</view>
