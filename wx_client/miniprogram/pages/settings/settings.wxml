<view class="page settings-page theme-{{theme}}">
  <view class="page-heading">
    <text class="eyebrow">ACCOUNT SETTINGS</text>
    <text class="page-title">账号设置</text>
    <text class="page-subtitle">管理个人资料、兴趣偏好和登录安全。</text>
  </view>

  <view class="card">
    <text class="eyebrow">PROFILE</text>
    <text class="block-title">个人资料</text>
    <view class="field">
      <text class="label">用户名</text>
      <input class="input" maxlength="50" value="{{username}}" bindinput="onUsernameInput" placeholder="用户名" />
    </view>
    <view class="field">
      <text class="label">邮箱</text>
      <view class="readonly-field">{{email || '未绑定'}}</view>
    </view>
    <button class="btn" loading="{{savingProfile}}" bindtap="saveProfile">保存资料</button>
  </view>

  <view class="card">
    <view class="row between">
      <view>
        <text class="eyebrow">INTERESTS</text>
        <text class="block-title">兴趣偏好</text>
      </view>
      <text class="muted">已选 {{selectedCount}} 项</text>
    </view>
    <text class="form-note">偏好会影响首页推荐，可多选。</text>
    <view class="preference-grid">
      <view
        wx:for="{{preferenceItems}}"
        wx:key="name"
        class="preference-item {{item.selected ? 'selected' : ''}}"
        data-index="{{index}}"
        bindtap="togglePreference"
      >
        <text class="preference-check">{{item.selected ? '✓' : ''}}</text>
        <text>{{item.name}}</text>
      </view>
    </view>
    <button class="btn preference-save" loading="{{savingPreferences}}" bindtap="savePreferences">保存兴趣偏好</button>
  </view>

  <view class="card">
    <text class="eyebrow">SECURITY</text>
    <text class="block-title">修改密码</text>
    <view class="field"><text class="label">当前密码</text><input class="input" password value="{{currentPassword}}" data-field="currentPassword" bindinput="onPasswordInput" placeholder="当前密码" /></view>
    <view class="field"><text class="label">新密码</text><input class="input" password value="{{newPassword}}" data-field="newPassword" bindinput="onPasswordInput" placeholder="至少 8 位，包含字母和数字" /></view>
    <view class="field"><text class="label">确认新密码</text><input class="input" password value="{{confirmPassword}}" data-field="confirmPassword" bindinput="onPasswordInput" placeholder="再次输入新密码" /></view>
    <button class="btn" loading="{{changingPassword}}" bindtap="changePassword">更新密码</button>
  </view>

  <view class="card danger-card">
    <text class="eyebrow">DANGER ZONE</text>
    <text class="block-title">注销账号</text>
    <text class="form-note">注销后无法登录，未成交商品会下架，历史订单不会删除。</text>
    <button class="btn btn-danger close-btn" bindtap="closeAccount">注销账号</button>
  </view>
</view>
