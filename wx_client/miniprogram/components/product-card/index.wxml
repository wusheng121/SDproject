<view class="product-card" bindtap="openProduct">
  <view class="product-image">
    <image wx:if="{{product.image_url}}" class="image" src="{{product.image_url}}" mode="aspectFill"></image>
    <view wx:else class="image-placeholder">
      <text>{{product.categories && product.categories.length ? product.categories[0] : '校园好物'}}</text>
    </view>
    <text wx:if="{{product.condition}}" class="condition">{{product.condition}}</text>
  </view>
  <view class="product-info">
    <text class="product-category">{{product.categories && product.categories.length ? product.categories[0] : '校园好物'}}</text>
    <text class="product-name line-clamp">{{product.name}}</text>
    <view class="product-bottom">
      <text class="product-price">¥{{product.price}}</text>
      <text wx:if="{{product.behavior_count}}" class="product-interest">{{product.behavior_count}} 人关注</text>
    </view>
  </view>
</view>
